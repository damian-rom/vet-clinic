    "@vet-clinic/types": "*",
    "@vet-clinic/validation": "*",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",

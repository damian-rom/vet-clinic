{
  "name": "vet-clinic",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "demo": "node scripts/demo.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "turbo build",
    "lint": "eslint apps packages tests scripts playwright.config.ts --max-warnings=0",
    "format": "prettier --write apps packages tests scripts *.json *.mjs playwright.config.ts README.md docs/architecture.md docs/acceptance.md docs/presentation.md .github",
    "format:check": "prettier --check apps packages tests scripts *.json *.mjs playwright.config.ts README.md docs/architecture.md docs/acceptance.md docs/presentation.md .github",
    "pretest": "turbo build --filter=@vet-clinic/app",
    "test": "pnpm --filter @vet-clinic/app test",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.tests.json",
    "db:migrate": "pnpm --filter @vet-clinic/app db:migrate",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.10",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "better-sqlite3": "13.0.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "fsevents",
      "prisma"
    ]
  }
}

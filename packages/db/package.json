{
  "name": "@vet-clinic/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc --outDir dist --declaration",
    "lint": "tsc --noEmit",
    "typecheck": "prisma generate && tsc --noEmit",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@vet-clinic/config": "workspace:*",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.2.3"
  }
}
